# Save this as .env.example in your project root
"""
COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL VALUES
cp .env.example .env
"""

API Keys (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Azure Additional (if using Azure provider)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15

# Model Configuration (Optional - defaults from config/settings.yaml)
DEFAULT_MODEL=gpt-4
JUDGE_MODEL=gpt-4
TEMPERATURE=0.7

# Rate Limiting (Optional)
MAX_RETRIES=3
RATE_LIMIT_RPM=60
TIMEOUT_SECONDS=60
ENABLE_CACHING=true

# Cost Tracking (Optional)
ENABLE_COST_TRACKING=true
BUDGET_ALERT_THRESHOLD=10.0

# Logging Configuration (Optional)
LOG_LEVEL=INFO
LOG_FILE=logs/evaluation.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Output Configuration (Optional)
REPORTS_DIR=reports
SAVE_RAW_RESPONSES=true
EXPORT_FORMAT=csv,json

# Security (Optional)
ENABLE_DATA_SANITIZATION=true
MAX_STRING_LENGTH=10000
